# Set a LangChain init-string ("provider:model") to run the harness live.
# Example uses Claude; install the matching @langchain/<provider> package if you switch providers.
PLANGUARD_MODEL=anthropic:claude-sonnet-5
ANTHROPIC_API_KEY=

PLANGUARD_BOOTSTRAP_MODE=false
# Required by the API's POST /analysis/terraform-plan endpoint. Generate and store a high-entropy
# value in the PlanGuard server environment and pass the same value to the Action as a GitHub Secret.
PLANGUARD_API_TOKEN=

# Required only when running the GitHub App webhook/API server.
PLANGUARD_GITHUB_APP_ID=
PLANGUARD_GITHUB_PRIVATE_KEY=
PLANGUARD_GITHUB_WEBHOOK_SECRET=
PORT=3000
