{
  "name": "@planguard/github-client",
  "private": true,
  "version": "0.0.0",
  "description": "GitHub App auth, webhook signature verification, and Check Run client (docs/PRODUCT_PLAN.md #10, #6.7).",
  "type": "module",
  "types": "./dist/src/index.d.ts",
