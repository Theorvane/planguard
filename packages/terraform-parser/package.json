{
  "name": "@planguard/terraform-parser",
  "private": true,
  "version": "0.0.0",
  "description": "Parses `terraform show -json` plan output into ResourceChange[] (docs/PRODUCT_PLAN.md #6.1).",
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "main": "./dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@planguard/schemas": "*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
